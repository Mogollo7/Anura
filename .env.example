# PostgreSQL
POSTGRES_USER=anura_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=anura
DATABASE_URL=postgresql://anura_user:change_me@postgres:5432/anura

# Roles de Postgres (Fase 2). La contraseña de cada URL debe coincidir
# con la variable *_DB_PASSWORD. Solo letras y números.
# db-migrate (03-roles.sh) exige las 7 *_DB_PASSWORD (auth, observation, explorer, geo, thumbnail,
# notification, dataset) y aborta si falta una. dataset_service (phase4+) es dueño del esquema dataset.
AUTH_DB_PASSWORD=change_me_auth
OBSERVATION_DB_PASSWORD=change_me_obs
EXPLORER_DB_PASSWORD=change_me_explorer
GEO_DB_PASSWORD=change_me_geo
THUMBNAIL_DB_PASSWORD=change_me_thumb
NOTIFICATION_DB_PASSWORD=change_me_notif
DATASET_DB_PASSWORD=change_me_dataset
AUTH_DB_URL=postgresql://auth_service:change_me_auth@postgres:5432/anura
OBSERVATION_DB_URL=postgresql://observation_service:change_me_obs@postgres:5432/anura
EXPLORER_DB_URL=postgresql://explorer_service:change_me_explorer@postgres:5432/anura
GEO_DB_URL=postgresql://geo_service:change_me_geo@postgres:5432/anura
THUMBNAIL_DB_URL=postgresql://thumbnail_service:change_me_thumb@postgres:5432/anura
NOTIFICATION_DB_URL=postgresql://notification_service:change_me_notif@postgres:5432/anura
DATASET_DB_URL=postgresql://dataset_service:change_me_dataset@postgres:5432/anura
INTERNAL_SERVICE_TOKEN=change_me_internal_token

# JWT
JWT_SECRET=change_me_secret

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
MINIO_ENDPOINT=minio
MINIO_PORT=9000
# Bucket de fotos de observaciones (opcional; por defecto anura-images). El bucket del dataset
# (anura-dataset) va fijo en docker-compose.server.yml y lo crea minio-init.
# MINIO_BUCKET=anura-images
# Dirección de MinIO que ve el NAVEGADOR/teléfono (va dentro de la firma de las URLs prefirmadas de
# dataset-service). En producción DEBE ser la URL pública (p. ej. https://minio.tu-dominio); con el
# valor por defecto (http://localhost:9000) las fotos del panel no cargan fuera de este PC.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# MINIO_USE_SSL=true

# Redis
REDIS_URL=redis://redis:6379

# Cloudflare Tunnel (servicio tunnel del compose; sin token el túnel no arranca)
TUNNEL_TOKEN=

# pgAdmin (servicio pgadmin del compose, puerto 5050): cuenta de acceso. Usa una clave larga.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me

# Frontend URL (para Google OAuth callback)
FRONTEND_URL=https://anura.juanlabs.me

# Service URLs (for Gateway/Proxy)
AUTH_SERVICE_URL=http://auth-service:3001
OBSERVATION_SERVICE_URL=http://observation-service:3002
GEO_SERVICE_URL=http://geo-service:3003
THUMBNAIL_SERVICE_URL=http://thumbnail-service:3004
EXPLORER_SERVICE_URL=http://explorer-service:3005
NOTIFICATION_SERVICE_URL=http://notification-service:3006
VALIDATION_SERVICE_URL=http://validation-service:3007

# Node env
NODE_ENV=development

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://anura.juanlabs.me/api/auth/google/callback


# model-service (docker-compose.model.yml): BioCLIP 2.5 y, más adelante, el worker y el creador.
# Vive siempre en el PC con GPU. Con todo en este PC: host.docker.internal.
# Con el servidor en Hostinger: la URL del túnel hacia este PC (https://...).
# El Admin (admin-web) también la usa para sondear /health de model-service.
MODEL_SERVICE_URL=http://host.docker.internal:8000
# S2: cuando exista Grafana en monitoring. Vacío = el panel muestra «sin datos» (no inventa métricas).
GRAFANA_URL=
# Secreto compartido servidor ↔ model-service (header X-Model-Token). Vacío = sin control.
MODEL_SERVICE_TOKEN=change_me_model_token
# Interfaz donde publica model-service. 127.0.0.1 = solo este PC.
MODEL_SERVICE_BIND=127.0.0.1

# M2: model-service pide trabajos a dataset-service con este token (header X-Worker-Token).
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
# Obligatorio para usar el worker: vacío = las rutas /api/worker/* responden 401 siempre (nunca quedan abiertas).
# Debe ser el MISMO valor en el .env de este compose y en el de docker-compose.model.yml.
WORKER_TOKEN=
# Dónde encuentra model-service a dataset-service. En este PC, por el puerto publicado;
# con el servidor en Hostinger, la URL pública (nginx /api/worker → dataset-service).
DATASET_SERVICE_URL=http://host.docker.internal:3008

# K2 — firma Ed25519 del catálogo de contenido público (manifest + sha256, mismo mecanismo que
# C1). Generar una sola vez con: node -e "const c=require('crypto');const{privateKey}=c.generateKeyPairSync('ed25519');console.log(Buffer.from(privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'))"
# La clave pública correspondiente (segura de compartir) se embebe en la app y la web — ver
# services/dataset-service/src/manifiesto.js y 19_ADMIN/Ficha Publica, Explorador y Destacados.md.
# Es un secreto: solo va en .env (ignorado por git). No cambiarla después de publicar: la app y la web
# verifican con la clave pública embebida. Vacía = el manifiesto sale SIN firma y la app y la web no pueden verificarlo.
CONTENT_MANIFEST_PRIVATE_KEY_B64=
